# Per-box environment (/opt/dwellings/.env.host) — the only file that differs
# between worker boxes. Copy to .env.host on each box.

# Name of this box in logs and in claimed_by. Unique per box, so that
# "who holds what" in the runbook points at a machine. (Correctness does not
# depend on it: every process adds a random suffix to its claim owner.)
INSTANCE_ID=worker-01

# Postgres connections this box may open. A worker needs about
# LISTING_CONCURRENCY + 3. The fleet shares one max_connections:
#   sum(DB_MAX_CONNS) + 4 per running backfill tool + psql headroom
#   must stay <= max_connections - 3
DB_MAX_CONNS=6

# Listings rendered at once; empty = one per vCPU. Each is an ffmpeg process.
LISTING_CONCURRENCY=
IMAGE_CONCURRENCY=8
