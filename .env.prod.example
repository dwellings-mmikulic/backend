# Production environment template for the web box (/opt/dwellings/.env).
# Copy to .env on the server and fill in real secret values. NEVER commit the real .env.

# Database — the private-network Postgres box. Password is in ~/.config/dwellings/db-credentials (local) / Hetzner.
DATABASE_URL=postgres://dwellings:REPLACE_WITH_DB_PASSWORD@10.0.0.3:5432/dwellings?sslmode=disable

# Scheduler — standard 5-field cron expression (every 12 hours).
CRON_SCHEDULE=0 */12 * * *

# OpenWebNinja Real-Time Zillow Data API
ZILLOW_BASE_URL=https://api.openwebninja.com/realtime-zillow-data
ZILLOW_API_KEY=REPLACE_WITH_ZILLOW_API_KEY

SKIP_EXISTING=true
IMAGES_ENABLED=true

# Bunny CDN storage
BUNNY_STORAGE_ZONE=REPLACE
BUNNY_API_KEY=REPLACE
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_CDN_BASE_URL=https://your-zone.b-cdn.net

# Search criteria
# SEARCH_LOCATION: comma-separated ZIP codes; each is searched every cycle.
SEARCH_LOCATION=33950,33948,33983
SEARCH_HOME_STATUS=FOR_SALE
SEARCH_MAX_RESULTS=50

# Video rendering
VIDEO_ENABLED=true
VIDEO_SECONDS_PER_PHOTO=4

# HTTP server
HTTP_PORT=8080

# This server's public origin, used for the absolute URLs in the Roku feed
# (including the live channel entry). Empty = no liveFeeds entry.
PUBLIC_BASE_URL=https://api.dwellings.tv

# Linear channels — the 24/7 HLS streams assembled from the listing videos
# (/channels/*). All optional; the defaults are shown.
# LINEAR_ENABLED=true
# LINEAR_LINEUP_HOURS=6
# LINEAR_MIN_SCOPE_CLIPS=20
# LINEAR_EPG_HORIZON_HOURS=24
# Poster for the Roku live channel entry. Empty borrows the first ready
# listing's image; with neither, the live entry is omitted (Roku requires a
# thumbnail).
# LINEAR_LIVE_THUMBNAIL_URL=

# VAST ad tags from the ad server, returned as pre_roll_ad / mid_roll_ad by
# /api/v1/properties* and /channels/resolve for the Roku app to play through
# RAF (the app substitutes macros like ROKU_ADS_TRACKING_ID). Empty = null, no
# ads in that slot.
# AD_PREROLL_URL=
# AD_MIDROLL_URL=

# Concurrency / timeouts
LISTING_CONCURRENCY=
IMAGE_CONCURRENCY=8
HTTP_TIMEOUT_SECONDS=30
BUNNY_TIMEOUT_SECONDS=300
