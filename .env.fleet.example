# Fleet-wide environment (/opt/dwellings/.env.fleet) — MUST be byte-identical
# on every box that runs workers (ROLE=worker, and the web box when it runs
# ROLE=all). Check with:  sha256sum /opt/dwellings/.env.fleet
# Copy to .env.fleet and fill in the secrets. NEVER commit the real file.
#
# Why identical: all instances spend from ONE API budget ledger in Postgres.
# Its windows come from CRON_SCHEDULE and its effective limit is the largest
# API_BUDGET_PER_CYCLE any box passes — a box with a different schedule gets a
# second ledger and a second budget.

# Database — the private-network Postgres box.
DATABASE_URL=postgres://dwellings:REPLACE_WITH_DB_PASSWORD@10.0.0.3:5432/dwellings?sslmode=disable

# Budget windows. The schedule no longer triggers anything: a new window (and
# a fresh budget) starts at each activation, evaluated in UTC.
CRON_SCHEDULE=0 */12 * * *
# OpenWebNinja requests the WHOLE FLEET may spend per window: search pages
# plus details calls. Details gets DETAILS_PER_CYCLE of it, search the rest.
# 1M listings ≈ 1.05M requests with details, ≈ 40–70k with DETAILS_PER_CYCLE=0.
API_BUDGET_PER_CYCLE=150
DETAILS_PER_CYCLE=50

# OpenWebNinja Real-Time Zillow Data API
ZILLOW_BASE_URL=https://api.openwebninja.com/realtime-zillow-data
ZILLOW_API_KEY=REPLACE_WITH_ZILLOW_API_KEY

# Search criteria (0 = unlimited; a ZIP truncated by SEARCH_MAX_RESULTS is
# still marked searched, so keep 0 for a national pass).
SEARCH_HOME_STATUS=FOR_SALE
SEARCH_MAX_RESULTS=0

SKIP_EXISTING=true
IMAGES_ENABLED=true

# Bunny CDN storage
BUNNY_STORAGE_ZONE=REPLACE
BUNNY_API_KEY=REPLACE
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_CDN_BASE_URL=https://your-zone.b-cdn.net
BUNNY_TIMEOUT_SECONDS=300

# Video rendering. VIDEO_SECONDS_PER_PHOTO is part of the content hash:
# a box with a different value renders different videos for the same listing.
VIDEO_ENABLED=true
VIDEO_SECONDS_PER_PHOTO=4
# Frame rate of the rendered video. The listings are still photographs under a
# static overlay, so frames beyond the first of each photo are duplicates and a
# lower rate is nearly free throughput: measured 97s at 30 fps against 63s at
# 15 fps for the same listing, for 9% more file size. Unset = 30.
# Changing it only affects NEW renders; the channel then mixes frame rates, so
# check playback on the Roku app before rolling it out.
# VIDEO_FPS=30

# Workers segment every new render for the linear channels. Do NOT set this to
# false on workers "because they serve no channels": it is what turns
# segmentation on, and nothing a worker renders would ever air.
LINEAR_ENABLED=true

# Discovery pauses while this many listings wait in the queue (soft limit;
# <= 0 disables). 2000 ≈ 80 minutes of work for a 40 vCPU fleet.
QUEUE_HIGH_WATER=2000

HTTP_TIMEOUT_SECONDS=30
