# Database — for local non-Docker runs. In docker compose this is set automatically.
DATABASE_URL=postgres://dwellings:dwellings@localhost:5432/dwellings?sslmode=disable

# Scheduler — standard 5-field cron expression (default: every 12 hours).
CRON_SCHEDULE=0 */12 * * *

# Caps how many properties get a one-time details-API enrichment call per
# cycle (protects API quota). 0 disables enrichment entirely.
DETAILS_PER_CYCLE=50

# OpenWebNinja Real-Time Zillow Data API
ZILLOW_BASE_URL=https://api.openwebninja.com/realtime-zillow-data
ZILLOW_API_KEY=

# LocationIQ — static property maps, generated on demand by the detail
# endpoint and hosted on Bunny CDN. Leave empty to disable maps entirely.
LOCATIONIQ_API_KEY=

# Leave already-stored listings (by zpid) untouched — no re-upsert or re-render.
# Set to false to refresh existing listings (price, photos) each cycle.
SKIP_EXISTING=true

# Images — set to false to skip Bunny upload and store source Zillow URLs directly
# (handy for local/dev runs; Bunny vars below are only required when true).
IMAGES_ENABLED=true

# Bunny CDN storage
BUNNY_STORAGE_ZONE=
BUNNY_API_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_CDN_BASE_URL=https://your-zone.b-cdn.net

# Search criteria. ZIP codes come from the built-in zip_codes rotation table
# (all 29,670 US residential ZIPs, seeded automatically on first startup) —
# there is no location env var. Each cycle searches ZIPs in rotation order:
# never-searched first (most populous first), then stalest.
SEARCH_HOME_STATUS=FOR_SALE
SEARCH_MIN_PRICE=0
SEARCH_MAX_PRICE=0
SEARCH_MIN_BEDROOMS=0
# 0 = no per-ZIP result cap (the API budget below is the real limiter).
SEARCH_MAX_RESULTS=0

# Max OpenWebNinja requests one cycle may spend (search pages + details
# calls). Sized so a month of cycles fits the API plan: 150/cycle at two
# cycles/day ≈ 9,000/month against the Pro plan's 10,000.
API_BUDGET_PER_CYCLE=150

# Video rendering (Roku listing videos)
VIDEO_ENABLED=true
VIDEO_SECONDS_PER_PHOTO=4
MUSIC_DIR=assets/music
# Font for overlay text. In Docker this defaults to the bundled DejaVu font.
VIDEO_FONT_PATH=/usr/share/fonts/dejavu/DejaVuSans-Bold.ttf

# HTTP server (Roku Direct Publisher feed at /roku/feed.json, public listings
# API at /api/v1/properties*, plus /healthz)
HTTP_PORT=8080

# Concurrency. Renders are CPU-bound (defaults to CPU count); image downloads/
# uploads are I/O-bound. Lower LISTING_CONCURRENCY on small machines.
LISTING_CONCURRENCY=
IMAGE_CONCURRENCY=8

# Outbound HTTP timeout (seconds) for Zillow + image downloads
HTTP_TIMEOUT_SECONDS=30
# Bunny upload timeout (seconds) — large for big video files
BUNNY_TIMEOUT_SECONDS=300
